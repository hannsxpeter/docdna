{
  "schema": 1,
  "minimum_python": [
    3,
    8
  ],
  "platform_support": {
    "family": "posix",
    "support_level": "supported",
    "requirements": [
      "descriptor-relative filesystem access",
      "no-follow filesystem access"
    ]
  },
  "host_targets": [
    {
      "id": "agents-compatible",
      "label": "AGENTS.md-compatible agents",
      "support_level": "wiring-only",
      "install": {
        "support": "not-supported",
        "selector": null,
        "default_location": null
      },
      "wiring": {
        "support": "supported",
        "surfaces": [
          "agents"
        ]
      },
      "host_parity": {
        "status": "not-verified",
        "boundary": "A writable instruction surface does not prove host parity."
      }
    },
    {
      "id": "claude",
      "label": "Claude Code",
      "support_level": "install-and-wiring",
      "install": {
        "support": "supported",
        "selector": "claude",
        "default_location": "~/.claude/skills/docdna"
      },
      "wiring": {
        "support": "supported",
        "surfaces": [
          "claude"
        ]
      },
      "host_parity": {
        "status": "not-verified",
        "boundary": "Installation and wiring support do not prove host parity."
      }
    },
    {
      "id": "codex",
      "label": "Codex",
      "support_level": "install-and-wiring",
      "install": {
        "support": "supported",
        "selector": "codex",
        "default_location": "~/.codex/skills/docdna"
      },
      "wiring": {
        "support": "supported",
        "surfaces": [
          "agents"
        ]
      },
      "host_parity": {
        "status": "not-verified",
        "boundary": "Installation and AGENTS.md wiring support do not prove host parity."
      }
    },
    {
      "id": "cursor",
      "label": "Cursor",
      "support_level": "install-and-wiring",
      "install": {
        "support": "supported",
        "selector": "cursor",
        "default_location": "~/.cursor/skills/docdna"
      },
      "wiring": {
        "support": "supported",
        "surfaces": [
          "cursor"
        ]
      },
      "host_parity": {
        "status": "not-verified",
        "boundary": "Installation and rule wiring support do not prove host parity."
      }
    },
    {
      "id": "gemini",
      "label": "Gemini",
      "support_level": "wiring-only",
      "install": {
        "support": "not-supported",
        "selector": null,
        "default_location": null
      },
      "wiring": {
        "support": "supported",
        "surfaces": [
          "gemini"
        ]
      },
      "host_parity": {
        "status": "not-verified",
        "boundary": "GEMINI.md wiring support does not prove install support or host parity."
      }
    },
    {
      "id": "github-copilot",
      "label": "GitHub Copilot",
      "support_level": "wiring-only",
      "install": {
        "support": "not-supported",
        "selector": null,
        "default_location": null
      },
      "wiring": {
        "support": "supported",
        "surfaces": [
          "copilot"
        ]
      },
      "host_parity": {
        "status": "not-verified",
        "boundary": "Instruction-file wiring support does not prove install support or host parity."
      }
    },
    {
      "id": "windsurf-cascade",
      "label": "Windsurf and Cascade",
      "support_level": "install-and-wiring",
      "install": {
        "support": "supported",
        "selector": "windsurf",
        "default_location": "~/.codeium/windsurf/skills/docdna"
      },
      "wiring": {
        "support": "supported",
        "surfaces": [
          "cascade"
        ]
      },
      "host_parity": {
        "status": "not-verified",
        "boundary": "Installation and rule wiring support do not prove host parity."
      }
    }
  ],
  "wiring_surfaces": [
    {
      "id": "agents",
      "paths": [
        "AGENTS.md"
      ]
    },
    {
      "id": "cascade",
      "paths": [
        ".devin/rules/docdna.md",
        ".windsurf/rules/docdna.md"
      ]
    },
    {
      "id": "claude",
      "paths": [
        "CLAUDE.md"
      ]
    },
    {
      "id": "copilot",
      "paths": [
        ".github/copilot-instructions.md"
      ]
    },
    {
      "id": "cursor",
      "paths": [
        ".cursor/rules/docdna.mdc"
      ]
    },
    {
      "id": "gemini",
      "paths": [
        "GEMINI.md"
      ]
    }
  ],
  "runtime_members": [
    {
      "id": "command.backfill",
