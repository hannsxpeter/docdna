      ],
      "counterfactual": "you sell to EU customers",
      "docs_moved": 11
    },
    {
      "id": "q6_downtime",
      "prompt": "If it were down for a day, what breaks and how fast must it be back?",
      "answers": [
        "nothing",
        "inconvenience-days",
        "business-process-hours",
        "revenue-or-safety-minutes"
      ],
      "multi_select": false,
      "ask_on_first_run": false,
      "default_from": [
        {
          "when": {
            "all": [
              {
                "signal": "deploy.cd",
                "is": "present"
              },
              {
                "not": {
                  "signal": "ops.oncall",
                  "is": "present"
                }
              }
            ]
          },
          "value": "inconvenience-days",
          "cite": [
            "deploy.cd",
            "ops.oncall"
          ]
        },
        {
          "when": {
            "signal": "ops.oncall",
            "is": "present"
          },
          "value": "business-process-hours",
          "cite": [
            "ops.oncall"
          ]
        }
      ],
      "fallback": "nothing",
      "counterfactual": "a day of downtime costs money or safety",
      "docs_moved": 5
    },
    {
      "id": "q7_maintenance",
      "prompt": "Will anyone maintain these documents after today?",
      "answers": [
        "named-owner",
        "a-team",
        "snapshot"
      ],
      "multi_select": false,
      "ask_on_first_run": false,
      "default_from": [
        {
          "when": {
            "signal": "proc.codeowners",
            "is": "present"
          },
          "value": "a-team",
          "cite": [
            "proc.codeowners"
          ]
        },
        {
          "when": {
            "all": [
              {
                "signal": "proc.authors_12mo",
                "gte": 1
              },
              {
                "not": {
                  "signal": "proc.authors_12mo",
                  "gte": 2
                }
              }
            ]
          },
          "value": "named-owner",
          "cite": [
            "proc.authors_12mo"
          ]
        }
      ],
      "fallback": "snapshot",
      "counterfactual": "someone maintains these documents after today",
      "docs_moved": 0
    },
    {
      "id": "q8_doc_location",
      "prompt": "Where does your documentation live?",
      "answers": [
        "repo",
        "repo-plus-wiki",
        "mostly-elsewhere"
      ],
      "multi_select": false,
      "ask_on_first_run": false,
      "default_from": [
        {
          "when": {
            "any": [
              {
                "signal": "docs.docs_dir",
                "is": "present"
              },
              {
                "signal": "docs.site_generator",
                "is": "present"
              },
              {
                "signal": "docs.readme",
                "is": "present"
              }
            ]
          },
          "value": "repo",
          "cite": [
            "docs.docs_dir",
            "docs.site_generator",
            "docs.readme"
          ]
        }
      ],
      "fallback": "repo",
      "counterfactual": "most of your documentation lives outside this repo",
      "docs_moved": 0,
      "always_state": true,
      "always_state_text": "I only see documentation committed to this repo. If your docs live in Confluence or Notion, say so and I will mark those rows present-elsewhere rather than missing."
    }
  ]
