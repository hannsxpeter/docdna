              },
              {
                "any": [
                  {
                    "signal": "users.gc_design_system",
                    "is": "present"
                  },
                  {
                    "signal": "jur.gc_domain",
                    "is": "hint"
                  },
                  {
                    "signal": "jur.protected_b",
                    "is": "hint"
                  }
                ]
              }
            ]
          },
          "value": "government-authorizer",
          "prompts": true,
          "cite": [
            "jur.gc",
            "users.gc_design_system",
            "jur.gc_domain",
            "jur.protected_b"
          ]
        },
        {
          "when": {
            "all": [
              {
                "signal": "jur.us_federal",
                "is": "hint"
              },
              {
                "signal": "sec.compliance_program",
                "is": "present"
              }
            ]
          },
          "value": "government-authorizer",
          "prompts": true,
          "cite": [
            "jur.us_federal",
            "sec.compliance_program"
          ]
        }
      ],
      "fallback": "none",
      "counterfactual": "a regulated relationship or external reviewer applies",
      "docs_moved": 19
    },
    {
      "id": "q4_decides_about_people",
      "prompt": "Does it make, or materially assist, decisions about individual people?",
      "answers": [
        "no",
        "internal-ops-only",
        "affects-money-services-employment-or-legal-status"
      ],
      "multi_select": false,
      "ask_on_first_run": false,
      "default_from": [],
      "fallback": "no",
      "counterfactual": "this decides something about individual people",
      "docs_moved": 8,
      "no_signal_may_set": true
    },
    {
      "id": "q5_markets",
      "prompt": "Which markets do your users sit in?",
