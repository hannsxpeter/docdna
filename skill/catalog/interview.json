              {
                "signal": "jur.gc",
                "is": "hint"
              }
            ]
          },
          "value": [
            "canada",
            "eu-eea"
          ],
          "prompts": true,
          "cite": [
            "jur.eu",
            "jur.gc"
          ]
        },
        {
          "when": {
            "signal": "jur.eu",
            "is": "hint"
          },
          "value": [
            "eu-eea"
          ],
          "prompts": true,
          "cite": [
            "jur.eu"
          ]
        },
        {
          "when": {
            "signal": "jur.gc",
            "is": "hint"
          },
          "value": [
            "canada"
          ],
          "prompts": true,
          "cite": [
            "jur.gc"
          ]
        }
      ],
      "fallback": [
