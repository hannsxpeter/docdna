{
  "schema": 1,
  "questions": [
    {
      "id": "q1_users",
      "prompt": "Who uses this, besides you?",
      "answers": [
        "nobody",
        "my-team",
        "other-teams",
        "customers",
        "public"
      ],
      "multi_select": false,
      "ask_on_first_run": false,
      "default_from": [
        {
          "when": {
            "all": [
              {
                "signal": "users.published_package",
                "is": "present"
              },
              {
                "signal": "supply.license_permissive",
                "is": "present"
              }
            ]
          },
          "value": "public",
          "cite": [
            "users.published_package",
            "supply.license_permissive"
          ]
        },
        {
          "when": {
            "all": [
              {
                "signal": "users.public_signup",
                "is": "present"
              },
              {
                "signal": "data.multi_tenant",
                "is": "present"
              }
            ]
          },
          "value": "customers",
          "cite": [
            "users.public_signup",
            "data.multi_tenant"
          ]
        },
        {
          "when": {
            "all": [
              {
                "signal": "deploy.cd",
                "is": "present"
              },
              {
                "not": {
                  "signal": "users.public_signup",
                  "is": "present"
                }
              }
            ]
          },
          "value": "my-team",
          "cite": [
            "deploy.cd",
            "users.public_signup"
          ]
        }
      ],
      "fallback": "nobody",
      "counterfactual": "people outside your team use this",
      "docs_moved": 14
    },
    {
      "id": "q2_operator",
      "prompt": "Who runs it in production, and can they page someone?",
      "answers": [
        "not-deployed",
        "the-authors",
        "separate-ops-team",
        "customer-operated"
      ],
      "multi_select": false,
      "ask_on_first_run": false,
      "default_from": [
        {
          "when": {
            "signal": "deploy.cd",
            "is": "present"
          },
          "value": "the-authors",
          "cite": [
            "deploy.cd"
          ]
        }
      ],
      "fallback": "not-deployed",
      "counterfactual": "a separate ops team runs this",
      "docs_moved": 13
    },
    {
