{
  "name": "@hxp-tools/docdna",
  "version": "1.5.0",
  "description": "Decides which documents a codebase owes, rules out the rest with a cited reason and a tripwire, and writes the ones the code can prove. Stdlib-only Python skill for Claude Code, Codex, Cursor, and Windsurf.",
  "bin": {
    "docdna": "bin/docdna.js"
  },
  "scripts": {
    "start": "node bin/docdna.js",
    "test": "python3 -m unittest discover -s tests",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm test && npm run pack:check",
    "prepublishOnly": "npm run release:check"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "documentation",
    "docs",
    "ai",
    "ai-agents",
    "claude-code",
